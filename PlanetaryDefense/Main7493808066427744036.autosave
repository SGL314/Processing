import java.util.ArrayList;

Planet aurora = new Planet("Aurora",400, 700, 100,#B550FF);
ArrayList<Bullet> bullets = new ArrayList<Bullet>();
ArrayList<Bullet> removeBullets = new ArrayList<Bullet>();
float timeToDrop = 4000,timeLastDrop = timeToDrop/4;

// KEY AND MOUSE
float mvx, mvy,zoom=1;

// GAME
boolean rush = false;

void setup(){
	size(800,800);
	timeLastDrop = millis();
	frameRate(60);
}


void draw(){
	scale(zoom);
  translate(mvx, mvy);
	background(255);
	//
	aurora.update();
	aurora.show();
	// if (millis() - timeLastDrop > timeToDrop){
	// 	timeLastDrop = millis();
	// 	bullets.add(new Bullet("circle",1,random(0,width/2),90-random(0,90),1,#FF0000,10));
	// }
	//
	ArrayList<Bullet> n_bullets = new ArrayList<Bullet>();
	for (int i = 0; i < bullets.size(); i++){
		if(bullets.get(i).update()){
			n_bullets.add(bullets.get(i));
			bullets.get(i).show();
		}else{
			// bullets.get(i).remove();
		}
	}
	bullets = n_bullets;
	n_bullets = new ArrayList<Bullet>();
	for (int i = 0; i < bullets.size(); i++){
		boolean add=true;
		for (int j = 0; j < removeBullets.size(); j++){
			if(bullets.get(i) == removeBullets.get(j)){
				bullets.set(i, null);
				add=false;
			}
		}
		if(add) n_bullets.add(bullets.get(i));
	}
	bullets = n_bullets;
	removeBullets = new ArrayList<Bullet>();
}

// KEYBOARD AND MOUSE

void keyPressed(){
	switch(key){
		case 'r':
			rush = !rush;
			break;
		case ENTER:
			float a = random(0,361), d=aurora.r*(random(50,101)/10.0);
			bullets.add(new Bullet("circle",aurora.x+d*cos(radians(a)),aurora.y-d*sin(radians(a)),a-180-random(0,90)+45,1,#FF0000,10));
			break;
		case ' ':
			aurora.kaboom();
			break;
	}
}
void mouseDragged() {
  mvx += (mouseX - pmouseX)/zoom;
  mvy += (mouseY - pmouseY)/zoom;
}
void mouseWheel(MouseEvent event) {
	float oldZoom = zoom;

  zoom *= pow(2, -event.getCount());

  float maxZ = 100;
  float minZ = 0.01;

  zoom = constrain(zoom, minZ, maxZ);

  float fator = zoom / oldZoom;

  mvx = mouseX / zoom - (mouseX / oldZoom - mvx);
  mvy = mouseY / zoom - (mouseY / oldZoom - mvy);
}
